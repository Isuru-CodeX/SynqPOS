# =============================================================================
# SynqPOS - Environment Configuration Example
# Maintainer: Isuru Rathnayaka <isururathnayaka999@gmail.com>
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# Supabase — Required at build & runtime for client database connection
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-public-key>

# Direct PostgreSQL Connection URL (for local migrations)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<your-project-ref>.supabase.co:5432/postgres

# Barcode Lookup API — https://www.barcodelookup.com
VITE_BARCODE_LOOKUP_API_KEY=<your-api-key>

# Google Gemini API — OCR & Intelligent Invoicing
GEMINI_API_KEY=<your-gemini-api-key>

# AI — OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Edge Functions / Omnichannel Integrations
RAPPI_WEBHOOK_SECRET=<shared-secret>
ALLOW_UNSIGNED_RAPPI_WEBHOOKS=false
RAPPI_IP_ALLOWLIST=<comma-separated-ip-list>
EVOLUTION_WEBHOOK_SECRET=<shared-secret>
EVOLUTION_IP_ALLOWLIST=<comma-separated-ip-list>
EVOLUTION_API_URL=https://<evolution-host>
EVOLUTION_API_KEY=<evolution-api-key>
